#!/usr/bin/env python3
"""
Glove80 Hardware Status Monitor & Dashboard Controller for Omarchy.

Features:
- Real-time USB detection for Left (16c0:27db) and Right (16c0:27d9) halves
- Djunho-style BlueZ GATT 0x2A19 enumeration for split battery levels
- Bluetooth device discovery & telemetry via BlueZ ObjectManager
- Dashboard actions: --connect, --disconnect, --trust, --untrust, --forget
- Desktop low-battery notifications with hysteresis
"""

import glob
import json
import os
import re
import subprocess
import sys

NOTIFY_STATE_FILE = "/tmp/glove80_battery_notified.json"
LOW_PCT = 20
CRITICAL_PCT = 10
RECOVERY_MARGIN = 5


def check_usb():
    """Detects whether Left and Right halves are plugged into USB."""
    left = False
    right = False

    for f in glob.glob("/sys/bus/usb/devices/*/idVendor"):
        try:
            with open(f, "r", encoding="utf-8", errors="ignore") as vf:
                vid = vf.read().strip().lower()

            pf = f.replace("idVendor", "idProduct")
            with open(pf, "r", encoding="utf-8", errors="ignore") as pf_file:
                pid = pf_file.read().strip().lower()

            if vid == "16c0":
                if pid == "27db":
                    left = True
                elif pid == "27d9":
                    right = True

            prod_path = f.replace("idVendor", "product")
            if os.path.exists(prod_path):
                with open(prod_path, "r", encoding="utf-8", errors="ignore") as prod_file:
                    pname = prod_file.read().strip().lower()
                    if "glove80 left" in pname:
                        left = True
                    elif "glove80 right" in pname:
                        right = True
        except OSError:
            pass

    return left, right


def get_device_info():
    """Queries BlueZ D-Bus ObjectManager for connected ZMK/Glove80 devices and GATT battery levels."""
    mac = None
    name = "Glove80"
    dev_path = None
    connected = False
    paired = False
    trusted = False
    gatt_battery_levels = []

    try:
        out = subprocess.check_output(
            ["busctl", "call", "-j", "org.bluez", "/", "org.freedesktop.DBus.ObjectManager", "GetManagedObjects"],
            text=True,
            timeout=2,
        )
        data = json.loads(out)["data"][0]

        # 1. Find device path (matching Glove80 or generic ZMK)
        for path, ifaces in data.items():
            if "org.bluez.Device1" in ifaces:
                dev = ifaces["org.bluez.Device1"]
                d_name = str(dev.get("Name", {}).get("data", "") or dev.get("Alias", {}).get("data", ""))
                modalias = str(dev.get("Modalias", {}).get("data", ""))
                if (
                    "glove80" in d_name.lower()
                    or "zmk" in d_name.lower()
                    or "v16c0p27db" in modalias.lower()
                    or "v1d50p615e" in modalias.lower()
                ):
                    dev_path = path
                    name = d_name or "Glove80"
                    mac = str(dev.get("Address", {}).get("data", ""))
                    connected = bool(dev.get("Connected", {}).get("data", False))
                    paired = bool(dev.get("Paired", {}).get("data", False))
                    trusted = bool(dev.get("Trusted", {}).get("data", False))
                    break

        # 2. Extract GATT battery levels (0x2A19) for this device (djunho approach)
        if dev_path:
            char_items = []
            for path, ifaces in data.items():
                if path.startswith(dev_path) and "org.bluez.GattCharacteristic1" in ifaces:
                    char_iface = ifaces["org.bluez.GattCharacteristic1"]
                    uuid = str(char_iface.get("UUID", {}).get("data", ""))
                    if uuid.lower().startswith("00002a19"):
                        val = char_iface.get("Value", {}).get("data", [])
                        level = val[0] if val else None
                        if level is None:
                            try:
                                r_out = subprocess.check_output(
                                    ["busctl", "call", "-j", "org.bluez", path, "org.bluez.GattCharacteristic1", "ReadValue", "a{sv}", "0"],
                                    text=True,
                                    timeout=1,
                                )
                                r_val = json.loads(r_out)["data"][0]
                                if r_val:
                                    level = r_val[0]
                            except Exception:
                                pass
                        if level is not None:
                            char_items.append((path, level))
            char_items.sort(key=lambda x: x[0])
            gatt_battery_levels = [lvl for _, lvl in char_items]
    except Exception:
        pass

    # Fallback to UPower if no GATT levels were read
    if not gatt_battery_levels:
        try:
            out = subprocess.check_output(["upower", "-e"], text=True, timeout=1)
            for line in out.splitlines():
                line = line.strip()
                if "keyboard" in line or "Glove80" in line:
                    dev_info = subprocess.check_output(["upower", "-i", line], text=True, timeout=1)
                    if "Glove80" in dev_info:
                        m = re.search(r"percentage:\s*([0-9]+)%", dev_info)
                        if m:
                            gatt_battery_levels.append(int(m.group(1)))
                            connected = True
                            break
        except Exception:
            pass

    battery = gatt_battery_levels[0] if gatt_battery_levels else None

    return {
        "address": mac or "",
        "name": name,
        "connected": connected,
        "paired": paired,
        "trusted": trusted,
        "battery": battery,
        "batteryLevels": gatt_battery_levels,
    }


def check_low_battery_notifications(battery: int | None, charging: bool):
    """Sends desktop notifications when battery reaches low or critical levels."""
    if battery is None or charging:
        if os.path.exists(NOTIFY_STATE_FILE):
            try:
                os.remove(NOTIFY_STATE_FILE)
            except OSError:
                pass
        return

    state = {"low": False, "critical": False}
    if os.path.exists(NOTIFY_STATE_FILE):
        try:
            with open(NOTIFY_STATE_FILE, "r", encoding="utf-8") as f:
                state = json.load(f)
        except Exception:
            state = {"low": False, "critical": False}

    if battery >= LOW_PCT + RECOVERY_MARGIN:
        state["low"] = False
    if battery >= CRITICAL_PCT + RECOVERY_MARGIN:
        state["critical"] = False

    if battery <= CRITICAL_PCT and not state.get("critical", False):
        try:
            subprocess.run(
                [
                    "notify-send",
                    "-u",
                    "critical",
                    "-i",
                    "battery-caution-symbolic",
                    "Glove80 battery critical",
                    f"{battery}% — charge now.",
                ],
                check=False,
                timeout=2,
            )
            state["critical"] = True
            state["low"] = True
        except Exception:
            pass
    elif battery <= LOW_PCT and not state.get("low", False):
        try:
            subprocess.run(
                [
                    "notify-send",
                    "-u",
                    "normal",
                    "-i",
                    "battery-low-symbolic",
                    "Glove80 battery low",
                    f"{battery}% remaining.",
                ],
                check=False,
                timeout=2,
            )
            state["low"] = True
        except Exception:
            pass

    try:
        with open(NOTIFY_STATE_FILE, "w", encoding="utf-8") as f:
            json.dump(state, f)
    except OSError:
        pass


def execute_action(action: str) -> dict:
    """Executes dashboard control actions via bluetoothctl."""
    dev = get_device_info()
    mac = dev.get("address")
    if not mac:
        return {"success": False, "error": "No paired Glove80 device found"}

    cmd = None
    if action == "--connect":
        cmd = ["bluetoothctl", "connect", mac]
    elif action == "--disconnect":
        cmd = ["bluetoothctl", "disconnect", mac]
    elif action == "--trust":
        cmd = ["bluetoothctl", "trust", mac]
    elif action == "--untrust":
        cmd = ["bluetoothctl", "untrust", mac]
    elif action == "--forget":
        cmd = ["bluetoothctl", "remove", mac]
    else:
        return {"success": False, "error": f"Unknown action: {action}"}

    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        return {
            "success": res.returncode == 0,
            "output": res.stdout.strip(),
            "error": res.stderr.strip() if res.returncode != 0 else "",
        }
    except Exception as e:
        return {"success": False, "error": str(e)}


def get_status():
    usb_l, usb_r = check_usb()
    dev = get_device_info()
    bt_conn = dev["connected"]
    levels = dev.get("batteryLevels", [])
    pct = dev["battery"]

    is_charging = usb_l or usb_r
    connected = usb_l or usb_r or bt_conn

    check_low_battery_notifications(pct, is_charging)

    # Djunho keyboard icon: \uf11c
    icon = " "

    if not connected:
        return {
            "connected": False,
            "text": f"{icon}Disconnected",
            "tooltip": "MoErgo Glove80: Disconnected",
            "battery": None,
            "batteryLevels": [],
            "charging": False,
            "usbLeft": False,
            "usbRight": False,
            "device": dev,
        }

    left_level = levels[0] if len(levels) > 0 else pct
    right_level = levels[1] if len(levels) > 1 else None

    # Format Left
    if usb_l:
        l_str = f"L⚡{left_level}%" if left_level is not None else "L⚡"
    elif left_level is not None:
        l_str = f"L{left_level}%"
    else:
        l_str = ""

    # Format Right
    if usb_r:
        r_str = f"R⚡{right_level}%" if right_level is not None else "R⚡"
    elif right_level is not None:
        r_str = f"R{right_level}%"
    else:
        r_str = ""

    # Djunho split formatting
    if len(levels) >= 2:
        text = f"{icon}{l_str} {r_str}".strip()
    elif usb_l and usb_r:
        text = f"{icon}⚡ {pct}%" if pct is not None else f"{icon}⚡ USB"
    elif usb_l:
        text = f"{icon}⚡ {pct}%" if pct is not None else f"{icon}⚡ USB"
    elif usb_r:
        text = f"{icon}{pct}% R⚡" if pct is not None else f"{icon}R⚡"
    else:
        if pct is not None:
            text = f"{icon}{pct}%"
        elif bt_conn:
            text = f"{icon}Connected"
        else:
            text = f"{icon}Disconnected"

    # Tooltip with connection details
    if usb_l and usb_r:
        conn_mode = "Both halves connected via USB"
    elif usb_l:
        conn_mode = "Left: USB (charging), Right: wireless"
    elif usb_r:
        conn_mode = "Left: wireless, Right: USB (charging)"
    else:
        conn_mode = "Bluetooth"

    if len(levels) >= 2:
        tooltip = f"MoErgo Glove80: Left {levels[0]}%, Right {levels[1]}% ({conn_mode})"
    elif pct is not None:
        tooltip = f"MoErgo Glove80: {pct}% ({conn_mode})"
    else:
        tooltip = f"MoErgo Glove80: {conn_mode}"

    return {
        "connected": True,
        "text": text,
        "tooltip": tooltip,
        "battery": pct,
        "batteryLevels": levels,
        "charging": is_charging,
        "usbLeft": usb_l,
        "usbRight": usb_r,
        "device": dev,
    }


def main():
    if len(sys.argv) > 1 and sys.argv[1].startswith("--"):
        arg = sys.argv[1]
        if arg in ("--connect", "--disconnect", "--trust", "--untrust", "--forget"):
            result = execute_action(arg)
            print(json.dumps(result))
            sys.exit(0 if result.get("success") else 1)

    status = get_status()
    print(json.dumps(status))


if __name__ == "__main__":
    main()
