#!/usr/bin/env python3
"""Poll a ZMK keymap or Glove80 JSON layout file and regenerate JSON on change."""

import json
import os
import signal
import subprocess
import sys
import time

POLL_INTERVAL = 1.0
PID_FILE = "/tmp/glove80_watcher.pid"


def _write_pid() -> None:
    with open(PID_FILE, "w", encoding="utf-8") as f:
        f.write(str(os.getpid()))


def _kill_existing() -> None:
    if not os.path.exists(PID_FILE):
        return
    try:
        with open(PID_FILE, "r", encoding="utf-8") as f:
            old_pid = int(f.read().strip())
        if old_pid != os.getpid():
            os.kill(old_pid, signal.SIGTERM)
            time.sleep(0.2)
    except (OSError, ValueError):
        pass


def _write_empty(output_json: str) -> None:
    with open(output_json, "w", encoding="utf-8") as f:
        json.dump({"layers": []}, f)


def _parse(keymap_file: str, output_json: str) -> bool:
    script_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    parser_cmd = [sys.executable, "-m", "keymap_parser", keymap_file]
    tmp = f"{output_json}.tmp"

    data: dict = {"layers": []}
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            result = subprocess.run(
                parser_cmd,
                cwd=script_dir,
                stdout=f,
                stderr=subprocess.PIPE,
                text=True,
            )
        if result.returncode == 0:
            os.replace(tmp, output_json)
            with open(output_json, "r", encoding="utf-8") as f:
                data = json.load(f)
            return True
    except Exception as exc:
        print(f"Parse error: {exc}", file=sys.stderr)

    _write_empty(output_json)
    return False


def _emit_json(data: dict) -> None:
    print(json.dumps(data, separators=(",", ":")), flush=True)


def main() -> None:
    if len(sys.argv) < 3:
        print("Usage: glove80-watcher <keymap_file> <output_json>", file=sys.stderr)
        sys.exit(1)

    keymap_file = os.path.expanduser(sys.argv[1])
    output_json = sys.argv[2]

    _kill_existing()
    _write_pid()

    last_mtime: float | None = -1.0
    while True:
        try:
            mtime = os.path.getmtime(keymap_file) if os.path.exists(keymap_file) else None
            if mtime != last_mtime:
                _parse(keymap_file, output_json)
                last_mtime = mtime
                with open(output_json, "r", encoding="utf-8") as f:
                    _emit_json(json.load(f))
        except Exception as exc:
            print(f"Watcher error: {exc}", file=sys.stderr)
            _emit_json({"layers": []})
        time.sleep(POLL_INTERVAL)


if __name__ == "__main__":
    main()
